# ─── LLM ────────────────────────────────────────────────────────────────────
# Use any OpenAI-compatible endpoint. For free usage, point to a local Ollama
# instance or use OpenRouter free tier.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
# Default model — swap to "ollama/mistral" or any OpenRouter free model
DEFAULT_MODEL=gpt-4o-mini

# ─── Telegram ────────────────────────────────────────────────────────────────
# Create a bot via @BotFather on Telegram, paste the token here
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# The agent ID (UUID) that the Telegram bot routes messages to
TELEGRAM_AGENT_ID=

# ─── App ─────────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./yuno_platform.db
CHROMA_PERSIST_DIR=./chroma_data
SECRET_KEY=change_me_in_production_use_a_long_random_string
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
LOG_LEVEL=INFO
